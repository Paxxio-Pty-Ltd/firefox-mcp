{
  "manifest_version": 2,
  "name": "Firefox MCP Bridge",
  "version": "0.6.0",
  "description": "Lets a local MCP client read and control your Firefox tabs.",
  "permissions": [
    "tabs",
    "<all_urls>",
    "scripting",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "storage",
    "tabGroups"
  ],
  "background": {
    "scripts": [
      "background/network.js",
      "background/gif.js",
      "background/approvals.js",
      "background/activity.js",
      "background/emulation.js",
      "background/tools.js",
      "background/bridge.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page/console-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "MCP bridge: starting",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-mcp@paxxio.co.za",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
